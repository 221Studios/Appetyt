{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "test:translation": "tsx scripts/translation-regression.ts",
    "test:search": "tsx scripts/search-regression.ts",
    "test:measurements": "tsx scripts/measurement-regression.ts",
    "check:measurements": "tsx scripts/normalize-measurement-form.ts",
    "translate:catalog": "tsx scripts/translate-catalog.ts",
    "translate:catalog:local": "tsx scripts/translate-catalog.ts --provider local --local-model qwen3.5:27b --batch-size 1 --concurrency 1",
    "translate:catalog:free": "tsx scripts/translate-catalog.ts --provider google-free --batch-size 1 --concurrency 1 --delay-ms 750",
    "validate:translations": "tsx scripts/translate-catalog.ts --validate-only",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "mobile:sync": "npm run build && cap sync",
    "mobile:android": "npm run mobile:sync && cap open android",
    "mobile:ios": "npm run mobile:sync && cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
