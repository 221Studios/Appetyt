# GEMINI_API_KEY: Used by the optional server-side catalog translation script.
# Never expose this key in the browser bundle or commit a real value.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL of the deployed client.
# Used for self-referential links, OAuth callbacks, and API endpoints when configured.
APP_URL="MY_APP_URL"

# Backend API base URL used by the web login controls.
VITE_API_URL="http://localhost:8000/api/v1"
