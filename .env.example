DATABASE_URL=postgresql+psycopg://appetyt:appetyt@localhost:5432/appetyt
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost,https://localhost,capacitor://localhost
ENVIRONMENT=development

# Google OAuth web login. Register this exact redirect URI in Google Cloud:
# http://localhost:8000/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
AUTH_FRONTEND_URL=http://localhost:3000
AUTH_SESSION_TTL_DAYS=365
# Leave false for local HTTP; use true behind HTTPS in production.
AUTH_COOKIE_SECURE=false

# Local SQLite (Foxx seed):
# DATABASE_URL=sqlite:///./data/appetyt-dev.sqlite
